rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // ADMIN
    // =========================================================
    // Your Firebase Auth UID
    // =========================================================

    function isAdmin() {
      return request.auth != null
        && request.auth.uid == "YlHNNCpBdThiY53y4J3SKXmzPcl2";
    }


    // =========================================================
    // USERS
    // =========================================================

    match /users/{userId} {

      // User can access only their own profile
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;


      // =======================================================
      // WISHLIST
      // =======================================================

      match /wishlist/{productId} {

        allow read, write: if request.auth != null
                          && request.auth.uid == userId;
      }
    }


    // =========================================================
    // ORDERS
    // =========================================================

    match /orders/{orderId} {

      // Customer can create an order for themselves
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid;


      // Customer can read their own orders
      // Admin can read all orders
      allow read: if request.auth != null
                  && (
                    resource.data.userId == request.auth.uid
                    || isAdmin()
                  );


      // Customers cannot modify/delete orders
      // Admin can modify/delete orders
      allow update, delete: if isAdmin();
    }


    // =========================================================
    // PRODUCTS
    // =========================================================

    match /products/{productId} {

      // Everyone can view products
      allow read: if true;

      // Only admin can modify products
      allow write: if isAdmin();
    }


    // =========================================================
    // CATEGORIES
    // =========================================================

    match /categories/{categoryId} {

      // Everyone can view categories
      allow read: if true;

      // Only admin can modify categories
      allow write: if isAdmin();
    }


    // =========================================================
    // EMAIL QUEUE
    // =========================================================
    //
    // IMPORTANT:
    // Your Cloud Function uses:
    //
    // collection(db, "mail")
    //
    // The Firebase Admin SDK bypasses Firestore security rules,
    // so the Cloud Function does NOT need permission here.
    //
    // Normal users are not allowed to create/read email jobs.
    // =========================================================

    match /mail/{mailId} {
      allow read, write: if false;
    }


    // =========================================================
    // DENY EVERYTHING ELSE
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}